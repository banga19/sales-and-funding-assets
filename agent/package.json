{
  "name": "sokogate-sales-agent",
  "version": "1.0.0",
  "description": "Automated AI-powered sales and funding agent for Sokogate",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "ts-node src/database/migrate.ts",
    "migrate:down": "ts-node src/database/migrate.ts down",
    "migrate:status": "ts-node src/database/migrate.ts status",
    "seed:contacts": "ts-node src/database/seed/seed-contacts.ts",
    "report:weekly": "ts-node src/utils/generate-report.ts"
  },
  "keywords": [
    "sales",
    "automation",
    "ai",
    "agent",
    "crm"
  ],
  "author": "Sokogate Team",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.1.47",
    "@langchain/openai": "^1.4.6",
    "@sentry/node": "^7.108.0",
    "axios": "^1.16.1",
    "bullmq": "^5.4.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "nodemailer": "^8.0.7",
    "openai": "^4.100.0",
    "pg": "^8.11.3",
    "winston": "^3.11.0",
    "ws": "^8.20.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
