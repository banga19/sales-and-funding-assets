# ============================================
# AI Configuration
# ============================================
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MAX_TOKENS=1024

# ============================================
# Email Configuration
# ============================================
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=sales@sokogate.com
RESEND_FROM_NAME=Sokogate Sales Team

# SendGrid (backup)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=sales@sokogate.com

# ============================================
# Calendly Configuration
# ============================================
CALENDLY_API_KEY=xxx
CALENDLY_WEBHOOK_SIGNING_KEY=xxx
CALENDLY_EVENT_TYPE_UUID=xxx
CALENDLY_USER_URI=https://api.calendly.com/users/xxx

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:pass@host:5432/sokogate
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Job Queue Configuration
# ============================================
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=60000

# ============================================
# Rate Limiting
# ============================================
EMAIL_RATE_LIMIT_PER_DAY=50
EMAIL_RATE_LIMIT_PER_HOUR=10

# ============================================
# Monitoring Configuration
# ============================================
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info

# ============================================
# Agent Configuration
# ============================================
AGENT_ENABLED=true
AGENT_DRY_RUN=false
AGENT_DAILY_OUTREACH_TIME=09:00
AGENT_FOLLOWUP_CHECK_INTERVAL=6h
AGENT_METRICS_SYNC_INTERVAL=1h
AGENT_PORT=3002

# ============================================
# Feature Flags — 4 Pipelines
# ============================================
ENABLE_EMAIL=true
ENABLE_AUTO_FOLLOWUP=true
ENABLE_AUTO_SCHEDULING=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_OBJECTION_HANDLING=true
ENABLE_SALES_OUTREACH=true
ENABLE_INVESTOR_OUTREACH=true
ENABLE_FUNDING_OUTREACH=true
ENABLE_PARTNERSHIP_OUTREACH=true
ENABLE_PRODUCT_SOURCING=true
ENABLE_FUNDING_DIGEST=true
ENABLE_AUTO_PRODUCT_SOURCING=true

# ============================================
# Daily Outreach Targets (per pipeline)
# ============================================
DAILY_SALES_OUTREACH_TARGET=20
DAILY_INVESTOR_OUTREACH_TARGET=8
DAILY_FUNDING_OUTREACH_TARGET=10
DAILY_PARTNERSHIP_OUTREACH_TARGET=5

# ============================================
# Sokogate Product Sourcing
# ============================================
SOKOGATE_BASE_URL=https://sokogate.com
SCRAPER_MAX_PAGES=10
SCRAPER_MAX_PRODUCTS=50
SCRAPER_REQUEST_DELAY_MS=800
SCRAPER_TIMEOUT_MS=120000
AUTO_SOURCE_INTERVAL_HOURS=24

# ============================================
# Escalation Configuration
# ============================================
ESCALATION_EMAIL=founder@sokogate.com
ESCALATION_WEBHOOK=https://sokogate.com/api/escalations
ESCALATION_THRESHOLD_NEGATIVE_SENTIMENT=3
ESCALATION_THRESHOLD_COMPLEX_QUESTION=true