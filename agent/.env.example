# ============================================
# AI Configuration
# ============================================
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MAX_TOKENS=1024

# ============================================
# Email Configuration (Nodemailer)
# ============================================
# SMTP provider — nodemailer.service.ts reads these.
# Leave host empty to fall back to a console/blackhole stub (no email sent).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=sales@sokogate.com
SMTP_FROM_NAME=Sokogate Sales Team

# Resend API (existing — still used if SMTP_HOST is blank)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=sales@sokogate.com
RESEND_FROM_NAME=Sokogate Sales Team

# SendGrid (backup)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=sales@sokogate.com

# Email dev mode: set true to suppress real sends (console stub active regardless of SMTP_HOST)
EMAIL_DEV_MODE=false

# ============================================
# Calendly Configuration
# ============================================
CALENDLY_API_KEY=xxx
CALENDLY_WEBHOOK_SIGNING_KEY=xxx
CALENDLY_EVENT_TYPE_UUID=xxx
CALENDLY_USER_URI=https://api.calendly.com/users/xxx

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:pass@host:5432/sokogate
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# Job Queue Configuration
# ============================================
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=60000

# ============================================
# Rate Limiting
# ============================================
EMAIL_RATE_LIMIT_PER_DAY=50
EMAIL_RATE_LIMIT_PER_HOUR=10

# ============================================
# Monitoring Configuration
# ============================================
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info

# ============================================
# Agent Configuration
# ============================================
AGENT_ENABLED=true
ENABLE_AGENT_PANEL=true
AGENT_DRY_RUN=false
AGENT_DAILY_OUTREACH_TIME=09:00
AGENT_FOLLOWUP_CHECK_INTERVAL=6h
AGENT_METRICS_SYNC_INTERVAL=1h
AGENT_PORT=3002

# ============================================
# Feature Flags — 4 Pipelines
# ============================================
ENABLE_EMAIL=true
ENABLE_AUTO_FOLLOWUP=true
ENABLE_AUTO_SCHEDULING=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_OBJECTION_HANDLING=true
ENABLE_SALES_OUTREACH=true
ENABLE_INVESTOR_OUTREACH=true
ENABLE_FUNDING_OUTREACH=true
ENABLE_PARTNERSHIP_OUTREACH=true

# ============================================
# Daily Outreach Targets (per pipeline)
# ============================================
DAILY_SALES_OUTREACH_TARGET=20
DAILY_INVESTOR_OUTREACH_TARGET=8
DAILY_FUNDING_OUTREACH_TARGET=10
DAILY_PARTNERSHIP_OUTREACH_TARGET=5

# ============================================
# Sokogate Product Sourcing
# ============================================
SOKOGATE_BASE_URL=https://sokogate.com
SCRAPER_MAX_PAGES=10
SCRAPER_MAX_PRODUCTS=50
SCRAPER_REQUEST_DELAY_MS=800
SCRAPER_TIMEOUT_MS=120000
AUTO_SOURCE_INTERVAL_HOURS=24

# ============================================
# LangChain Agent Loop Factory — per-agent execution loops
# ============================================
# Set false to disable a loop entirely; defaults:
ENABLE_SOURCING_AGENT=true
ENABLE_MARKETING_AGENT=true
ENABLE_CONTENT_AGENT=true
ENABLE_FUNDING_PITCH_AGENT=true

# Individual per-run limits
BULK_SOURCE_DEFAULT_PAGES=3
BULK_SOURCE_MAX_PAGES=10
BULK_SOURCE_ENRICH_AI=false

# Search API for funding-pitch research (optional)
SEARCH_API_KEY=
SEARCH_API_PROVIDER=tavily

# Master switch execution order: true = sequential, false = parallel
MASTER_SWITCH_SEQUENTIAL=true