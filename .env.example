# ════════════════════════════════════════════════════════════════════════════════
# Sokogate Scraper — Environment Variables
# ────────────────────────────────────────────────────────────────────────────────
# Add to: .env (root)  →  shared by Node & Python workloads
# ────────────────────────────────────────────────────────────────────────────────

# ── Target site ────────────────────────────────────────────────────────────────
SOKOGATE_BASE_URL=https://sokogate.com
SOKOGATE_LISTING_PATH=/product-category
SOKOGATE_PRODUCT_PATH=/product

# ── Scraper parallelism / rate limits ─────────────────────────────────────────
SCRAPER_MAX_CONCURRENCY=4              # max simultaneous detail-page requests
SCRAPER_MAX_PAGES_PER_RUN=10           # max listing pages to crawl per run
SCRAPER_MAX_PRODUCTS_PER_RUN=50        # cap on detail pages scraped per run
SCRAPER_REQUEST_DELAY_MS=800           # base delay between requests (jittered × 0.3–1.7)
SCRAPER_TIMEOUT_SECONDS=25             # per-request timeout
SCRAPER_RETRY_ATTEMPTS=3              # retries per failed page
SCRAPER_RETRY_BACKOFF_BASE=2          # seconds; doubles each attempt

# ── Anti-bot / stealth ────────────────────────────────────────────────────────
SCRAPER_USER_AGENT_POOL_FILE=scraper/stealth/user_agents.json
SCRAPER_PROXY_POOL_FILE=              # optional: JSON file of proxy URLs
SCRAPER_PROXY_ENABLED=false            # true → load and rotate from proxy pool
SCRAPER_PROXY_ROTATION_EVERY=50        # rotate proxy after N requests
SCRAPER_USE_PLAYWRIGHT=false           # true → use headless Chromium for Challeneges
SCRAPER_PLAYWRIGHT_HEADLESS=true
SCRAPER_DISABLE_WEB_SECURITY=false     # set true for localhost testing only
SCRAPER_VERIFY_SSL=false               # set false to bypass self-signed/expired certs (e.g. sokogate.com)
SCRAPER_COOKIES_FILE=scraper/stealth/cookies.json

# ── PostgreSQL connection ─────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sokogate
POSTGRES_PASSWORD=sokogate-dev-change-me
POSTGRES_DB=sokogate
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ── Redis (Broker for Celery) ─────────────────────────────────────────────────
REDIS_URL=redis://:sokogate-redis-dev@localhost:6379/0

# ── Celery scheduling ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:sokogate-redis-dev@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:sokogate-redis-dev@localhost:6379/1
CELERY_BEAT_ENABLED=true
#                              min  hr  dom mon dow
CELERY_SCRAPE_SCHEDULE=0         2     *   *   *    # Every day at 02:00 UTC
CELERY_PRICE_ALERT_SCHEDULE=0    */2   *   *   *    # Every 2 hours

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_PORT=8000
FASTAPI_RELOAD=false                # true only in development
FASTAPI_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Alerting / notification ───────────────────────────────────────────────────
SLACK_WEBHOOK_URL=                  # optional Slack alert on scrape completion/failure
TELEGRAM_BOT_TOKEN=                 # optional Telegram alerting
TELEGRAM_CHAT_ID=
