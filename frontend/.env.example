# Frontend environment variables (Vite-safe)
# Copy to frontend/.env and customize as needed

# API base URL - should point to backend (proxy /api to backend in dev)
VITE_API_BASE_URL=/api

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# Demo mode - set to '1' to enable demo mode with mock data (default: disabled)
# VITE_DEMO_MODE=0
