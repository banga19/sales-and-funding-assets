PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:3002

# Agent Configuration
AGENT_ENABLED=true
AGENT_DRY_RUN=true

# Rate Limits (per day)
EMAIL_RATE_LIMIT=50
WHATSAPP_RATE_LIMIT=100

# Feature Flags
FEATURE_EMAIL=true
FEATURE_WHATSAPP=false
FEATURE_AUTO_FOLLOWUP=true
FEATURE_AUTO_SCHEDULING=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_OBJECTION_HANDLING=true

# Claude AI
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# WhatsApp
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=placeholder

# Database (PostgreSQL / Supabase)
DATABASE_URL=
