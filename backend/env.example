PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:3002

# Agent Configuration
AGENT_ENABLED=true
AGENT_DRY_RUN=true

# Rate Limits (per day)
EMAIL_RATE_LIMIT=50

# Feature Flags
FEATURE_EMAIL=true
FEATURE_AUTO_FOLLOWUP=true
FEATURE_AUTO_SCHEDULING=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_OBJECTION_HANDLING=true
FEATURE_PRODUCT_SCRAPING=true
FEATURE_PLAYWRIGHT_SCRAPER=true
FEATURE_SCRAPE_ENABLED=true
FEATURE_OUTREACH_ENABLED=true

# NVIDIA AI
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_URL=https://api.nvcf.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=sales@yourcompany.com

# WhatsApp
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=placeholder

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://sokogate:sokogate-dev-change-me@localhost:5432/sokogate
