PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:3002

# Agent Configuration
AGENT_ENABLED=true
AGENT_DRY_RUN=true

# Rate Limits (per day)
EMAIL_RATE_LIMIT=50

# Feature Flags
FEATURE_EMAIL=true
FEATURE_AUTO_FOLLOWUP=true
FEATURE_AUTO_SCHEDULING=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_OBJECTION_HANDLING=true

# NVIDIA AI
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# WhatsApp
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=placeholder

# Database (PostgreSQL / Supabase)
DATABASE_URL=
