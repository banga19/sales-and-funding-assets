# Server
PORT=3000
NODE_ENV=development

# CORS — space-separated origins
CORS_ORIGINS=http://localhost:3001 http://localhost:3000 http://localhost:3002

# ─────────────────────────────────────
# PostgreSQL (Supabase / local / RDS)
# ─────────────────────────────────────
# Local (Docker): postgresql://sokogate:sokogate-dev-change-me@localhost:5432/sokogate
# Supabase pooler:  postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://sokogate:sokogate-dev-change-me@localhost:5432/sokogate

# ─────────────────────────────────────
# NVIDIA AI — Deep Research & Email Gen
# ─────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_URL=https://api.nvcf.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ─────────────────────────────────────
# SMTP — Email Delivery
# ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=sales@yourcompany.com

# ─────────────────────────────────────
# Feature Flags (new)
# ─────────────────────────────────────
FEATURE_SCRAPE_ENABLED=true
FEATURE_OUTREACH_ENABLED=true

# ─────────────────────────────────────
# Logging
# ─────────────────────────────────────
LOG_LEVEL=info
